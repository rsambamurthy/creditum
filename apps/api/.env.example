# --- Database (one of: postgres | mssql | oracle) ---
DB_TYPE=postgres
DATABASE_URL=postgres://creditum@127.0.0.1:5432/creditum
# For SQL Server / Oracle use DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME (SQL Server) or DB_SERVICE_NAME (Oracle)
DB_SSL=false
MIGRATE_ON_START=false

# --- HTTP ---
PORT=3000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600

# --- Authentication ---
# Bank deployments: AUTH_MODE=oidc with the bank's identity provider.
AUTH_MODE=oidc
OIDC_ISSUER=https://login.example-bank.test/
OIDC_AUDIENCE=creditum
OIDC_JWKS_URI=https://login.example-bank.test/.well-known/jwks.json
OIDC_TENANT_CLAIM=creditum_tenant
OIDC_ROLES_CLAIM=creditum_roles
OIDC_NAME_CLAIM=name
TOKEN_TTL_SECONDS=3600
# Development / Railway demo only — never in a bank deployment:
# AUTH_MODE=dev
# ALLOW_DEV_AUTH=true
# DEV_JWT_SECRET=<at least 32 random characters>

# --- Core banking connector (optional) ---
# The endpoint implementing docs/integrations/core-banking-connector.md (the bank's adapter, or apps/corebank-sim in
# build/test). Leave CONNECTOR_CORE_BANKING_URL unset when there is none; tenants then cannot switch it on.
# CONNECTOR_CORE_BANKING_URL=https://corebanking-adapter.example-bank.test
# CONNECTOR_CORE_BANKING_KEY=<at least 24 characters, from the secrets store>
# CONNECTOR_TIMEOUT_MS=10000
