  "rules": [
    {
      "ruleKey": "ABC-001",
      "name": "Enhancements need client request details at submission",
      "entityType": "credit_request",
      "triggerOn": "on_submit",
      "condition": {
        "==": [
          {
            "var": "request_type"
          },
          "increase"
        ]
      },
      "actions": [
        {
          "type": "require",
          "field": "a.client_request.client_request_details",
          "message": "Client request details are required to submit an enhancement"
        }
